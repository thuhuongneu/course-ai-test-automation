# === He thong duoi test ===
BASE_URL=https://crm.anhtester.com

# === Tai khoan test (KHONG commit gia tri that - copy file nay thanh .env roi dien) ===
TEST_USERNAME=<email tai khoan test>
TEST_PASSWORD=<mat khau tai khoan test>

# Tai khoan vai tro Project Manager - CRM_LOGIN_TC_006 (menu rut gon)
PM_EMAIL=<email tai khoan Project Manager>
PM_PASSWORD=<mat khau tai khoan Project Manager>

# === Cau hinh chay ===
# false = mo browser that (debug local) | true = headless (CI)
HEADLESS=false

# So luong song song - DOI SO LUONG DUY NHAT O DAY
WORKERS=5

# Timeout mac dinh cho 1 test (ms)
TIMEOUT=90000
