<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Song song theo DEVICE: mỗi khối <test> là một device, chạy trên một thread riêng.
  thread-count = số device đang chạy thật. Chỉ có 1 emulator thì để 1 — nhiều phiên giành
  một máy là chắc chắn hỏng.

  Thêm device:
    1. Thêm 1 khối vào capabilities/devices.json (udid + systemPort RIÊNG)
    2. Thêm 1 khối <test> trỏ tới khối đó qua tham số "device"
    3. Tăng thread-count bằng số khối <test>
-->
<suite name="Book App - Android" parallel="tests" thread-count="1">
  <test name="Pixel_9 (emulator-5554)">
    <parameter name="device" value="android_emulator_5554"/>
    <packages>
      <package name="com.anhtester.book.tests"/>
    </packages>
  </test>
</suite>
