# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore — KHÔNG commit.
# CI truyền các khoá này qua biến môi trường (GitHub Secrets), không dùng file .env.

# Tài khoản đăng nhập dùng cho test. Giá trị có ký tự # thì PHẢI để trong nháy kép: TEST_PASSWORD="Abc#123"
# (không có nháy, phần sau # bị coi là comment và cắt mất)
TEST_USERNAME=
TEST_PASSWORD=

# Appium server mà bộ test kết nối tới
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Thời gian chờ tối đa cho mỗi element (giây)
WAIT_TIMEOUT_SECONDS=15
